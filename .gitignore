# Python 编译缓存
__pycache__/
*.pyc
*.pyo

# 工具自动生成目录
.mimosa/
.workbuddy/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# LaTeX 中间产物（保留 .tex / .pdf / .bbl）
# 注：*.log 亦覆盖工件包内作者运行期的控制台日志——那类日志含本机绝对路径，
#     不随包发布；MANIFEST 同样排除 *.log，以保证清单与发布范围严格一致。
*.aux
*.log
*.out
*.blg

# 临时工作目录
_tmp_*/

# 审计留痕（不公开发布）
_history/
